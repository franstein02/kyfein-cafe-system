# Nginx Configuration Example for Kyfein (Laragon Windows PC Server)
# Place this file or include it inside Laragon: laragon/etc/nginx/sites-enabled/kyfein.conf

server {
    listen 80;
    server_name kyfein.local 192.168.1.100; # Change to your PC server static IP or hostname

    # Root directory pointing to Flutter Web build output
    root "C:/laragon/www/kyfein-web";
    index index.html;

    # Serve Flutter Web SPA (Single Page Application)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy REST API traffic to FastAPI backend
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy WebSocket connection for KDS (Kitchen Display System)
    location /ws/ {
        proxy_pass http://127.0.0.1:8000/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";

    client_max_body_size 20M;
}
