# Kyfein Backend Environment Variables

PROJECT_NAME="Kyfein Cafe POS API"
API_V1_STR="/api/v1"

# Database Configuration (MySQL / Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_kyfein

# Security / JWT Settings
# Secret Key - change in production using `openssl rand -hex 32`
SECRET_KEY=secret_key_kyfein_cafe_system_2026_super_secure_token_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000", "http://localhost:8000", "*"]
